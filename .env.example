# Copy to .env.local (Next.js) or .env (worker) and fill in.
# Everything except DATABASE_URL is optional in development — see src/env.ts.

# ---- Database -------------------------------------------------------------
DATABASE_URL=postgres://polymetis:polymetis@localhost:5432/polymetis
# Direct/unpooled URL, used by drizzle-kit only. Managed Postgres providers
# inject this alongside the pooled URL.
# DATABASE_URL_UNPOOLED=
# DB_POOL_MAX=10
# DB_IDLE_TIMEOUT=20

# ---- Auth (M3) ------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-secret-change-me
BETTER_AUTH_URL=http://localhost:3000

# GitHub OAuth — primary sign-in provider and the source of the repo read
# scope. Unset means email/password sign-in only.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ---- Agent runtime (M2) ---------------------------------------------------
# Unset means runs cannot be executed. The gallery and replay of
# already-recorded runs still work — replay reads our own event log and never
# calls a model.
# ANTHROPIC_API_KEY=
# AGENT_MODEL=claude-opus-5
# AGENT_EFFORT=xhigh
# RUN_COST_CEILING_USD=5
# Circuit breaker the egress proxy enforces (tokens, not dollars). 0 disables.
# The default is the code's, and it is high on purpose: one measured
# issue-to-spec run consumed 3.5M tokens, almost all of it cache reads, so a
# ceiling in the low millions kills legitimate work.
# RUN_TOKEN_CEILING=8000000
# RUN_TIMEOUT_SECONDS=1800

# ---- Sandbox (M2, ADR-0003) -----------------------------------------------
# `none` runs the agent directly on the host — how the driver is developed
# before a container runtime exists. Production refuses it: see src/env.ts.
# SANDBOX_MODE=none
# SANDBOX_IMAGE=polymetis/sandbox:0.3.222
# SANDBOX_NETWORK=polymetis-sandbox
# SANDBOX_MEMORY=2g
# SANDBOX_CPUS=2
# Host port for the credential-injecting egress proxy. The container reaches it
# as http://polymetis-proxy:<port> and never holds a real credential.
# Used only when WORKER_CONCURRENCY=1: the ceiling and the usage meter are
# per-run, so each run gets its own proxy, and concurrent runs cannot share one
# fixed port. Above concurrency 1 the OS assigns them and the worker says so at
# startup — a firewall rule written against this port would be pointing at
# nothing.
# SANDBOX_PROXY_PORT=7777

# ---- Worker (M2) ----------------------------------------------------------
# WORKER_ID=local
# WORKER_CONCURRENCY=2
# WORKER_HEARTBEAT_SECONDS=15
